<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E3F2FD">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- 标题卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎬 直播背景播放器"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#1976D2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="零卡顿 · 无缝循环 · 全屏播放"
                        android:textSize="14sp"
                        android:textColor="#64B5F6"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 视频选择卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📹 选择视频"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1976D2"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_select_video"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="从本地选择视频"
                        app:cornerRadius="12dp"
                        android:backgroundTint="#42A5F5"
                        app:icon="@android:drawable/ic_menu_gallery"
                        style="@style/Widget.MaterialComponents.Button" />

                    <TextView
                        android:id="@+id/tv_selected_path"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="未选择视频"
                        android:textSize="13sp"
                        android:textColor="#757575"
                        android:layout_marginTop="12dp"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:padding="8dp"
                        android:background="#F5F5F5" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 播放设置卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚙️ 播放设置"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1976D2"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="循环模式"
                        android:textSize="14sp"
                        android:textColor="#424242"
                        android:layout_marginBottom="8dp" />

                    <Spinner
                        android:id="@+id/spinner_loop_mode"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:entries="@array/loop_modes"
                        android:background="@android:drawable/edit_text"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="音量"
                        android:textSize="14sp"
                        android:textColor="#424242"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="8dp" />

                    <SeekBar
                        android:id="@+id/seekbar_volume"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="0"
                        android:progressTint="#42A5F5"
                        android:thumbTint="#1976D2" />

                    <TextView
                        android:id="@+id/tv_volume_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0% - 静音模式"
                        android:textSize="13sp"
                        android:textColor="#757575"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 高级选项卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkbox_keep_screen_on"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="保持屏幕常亮（推荐）"
                        android:checked="true"
                        android:textSize="14sp"
                        android:textColor="#424242"
                        app:buttonTint="#1976D2" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 开始播放按钮 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🚀 确认并开始播放"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                android:backgroundTint="#1976D2"
                app:elevation="4dp"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
