<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- MD3 基础主题 -->
    <style name="Theme.LiveBgPlayer" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#1976D2</item>
        <item name="colorPrimaryVariant">#1565C0</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">#42A5F5</item>
        <item name="colorSecondaryVariant">#1E88E5</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">#E3F2FD</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    
    <!-- 全屏无遮挡主题 -->
    <style name="Theme.FullScreen" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
